{
  "name": "wmg-nav-console-ais-marine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run data-server\" \"next dev\"",
    "next": "next dev",
    "data-server": "node server/ais-server.js",
    "build": "next build",
    "serve": "concurrently \"npm run data-server\" \"next start -H 0.0.0.0\"",
    "start": "next start",
    "electron": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "@serialport/parser-readline": "^12.0.0",
    "concurrently": "^8.2.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "next": "14.2.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "serialport": "^12.0.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.12",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.5.3"
  },
  "main": "electron-main.js",
  "build": {
    "appId": "com.wmg.navconsole",
    "productName": "Nav Console",
    "asar": false,
    "forceCodeSigning": false,
    "npmRebuild": false,
    "files": [
      "**/*"
    ],
    "win": {
      "target": "dir"
    }
  }
}
